{
  "name": "weftdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "pnpm --filter @weft/desktop dev",
    "build": "pnpm --filter @weft/desktop build",
    "build:server": "node scripts/build-server.mjs",
    "dist": "node scripts/build-server.mjs && pnpm build && pnpm --filter @weft/desktop dist",
    "typecheck": "pnpm --filter @weft/desktop typecheck"
  }
}
